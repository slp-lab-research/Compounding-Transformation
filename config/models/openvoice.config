{
  "enabled": true,
  "mode": "openvoice",
  "generation_type": "clone",
  "python": "/mnt/synology_nas_00/nathan/conda_envs/openvoice/bin/python",
  "environment_note": "Install OpenVoice and MeloTTS in the openvoice environment before enabling this model.",
  "minimum_reference_duration_seconds": 5.5,
  "script_path": "/mnt/synology_nas_00/nathan/datasets/common_voice_text/mcv_text_lid.tsv",
  "reference_audio_path": "/mnt/synology_nas_00/nathan/datasets/LibriTTS",
  "worker": {
    "script": "/home/nathan/data_generation/extended_model_worker.py",
    "command": [
      "{python}", "{worker_script}", "--model", "{model}",
      "--script-path", "{script_path}", "--output-path", "{output_path}",
      "--reference-audio", "{reference_audio_path}", "--speaker-file",
      "{speaker_file}", "--speaker-index", "{speaker_index}", "--item", "{item}",
      "--transcript-text", "{transcript_text}",
      "--reference-audio-override", "{reference_audio_override}"
    ]
  }
}
